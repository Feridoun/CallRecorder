#include <windows.h>
#include <commctrl.h>

#include "../src/resource.h"
#include "version.h"  // generated by CMake from res/version.h.in

IDI_APP ICON "CallRecorder.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "CallRecorder.manifest"

IDD_CONNECTION DIALOGEX 0, 0, 300, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "CallRecorder: Speakr connection"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "CallRecorder uploads your recordings to your own Speakr server, which transcribes and summarises them.",
          -1, 10, 8, 280, 18
    LTEXT "Speakr address", -1, 10, 32, 280, 9
    EDITTEXT IDC_URL, 10, 42, 280, 13, ES_AUTOHSCROLL
    LTEXT "API token (create one in Speakr under Account settings > API tokens)", -1, 10, 62, 280, 9
    EDITTEXT IDC_TOKEN, 10, 72, 280, 13, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "The token is kept in Windows Credential Manager, never in a file.", -1, 10, 88, 280, 9
    LTEXT "", IDC_STATUS, 10, 104, 280, 18
    PUSHBUTTON "&Test", IDC_TEST, 10, 128, 50, 14
    DEFPUSHBUTTON "&Save", IDOK, 184, 128, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 240, 128, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION CALLRECORDER_VERSION_MAJOR, CALLRECORDER_VERSION_MINOR, CALLRECORDER_VERSION_PATCH, 0
PRODUCTVERSION CALLRECORDER_VERSION_MAJOR, CALLRECORDER_VERSION_MINOR, CALLRECORDER_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Fareedoon Ahmed"
            VALUE "FileDescription", "CallRecorder"
            VALUE "FileVersion", CALLRECORDER_VERSION_STRING
            VALUE "InternalName", "CallRecorder"
            VALUE "LegalCopyright", "Copyright (c) 2026 Fareedoon Ahmed. MIT licence."
            VALUE "OriginalFilename", "CallRecorder.exe"
            VALUE "ProductName", "CallRecorder"
            VALUE "ProductVersion", CALLRECORDER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
