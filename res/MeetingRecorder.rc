#include <windows.h>
#include <commctrl.h>

#include "../src/resource.h"
#include "version.h"  // generated by CMake from res/version.h.in

IDI_APP ICON "MeetingRecorder.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "MeetingRecorder.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 320, 386
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "MeetingRecorder settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX "Speakr connection", -1, 7, 5, 306, 107
    LTEXT "Recordings upload to your Speakr server for transcripts and summaries.",
          -1, 14, 17, 292, 9
    LTEXT "&Address", -1, 14, 33, 58, 9
    EDITTEXT IDC_URL, 76, 31, 230, 13, ES_AUTOHSCROLL
    LTEXT "API &token", -1, 14, 50, 58, 9
    EDITTEXT IDC_TOKEN, 76, 48, 230, 13, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "Create one in Speakr under Account settings > API tokens. It's kept in Windows Credential Manager, never in a file.",
          -1, 76, 63, 230, 17
    PUSHBUTTON "T&est", IDC_TEST, 14, 83, 50, 14
    LTEXT "", IDC_STATUS, 76, 82, 230, 26

    GROUPBOX "Audio devices", -1, 7, 117, 306, 50
    LTEXT "&Microphone", -1, 14, 132, 58, 9
    COMBOBOX IDC_MIC, 76, 130, 230, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Playback", -1, 14, 149, 58, 9
    COMBOBOX IDC_SPEAKERS, 76, 147, 230, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Recordings", -1, 7, 172, 306, 187
    LTEXT "Default ta&gs", -1, 14, 187, 58, 9
    EDITTEXT IDC_TAGS, 76, 185, 230, 13, ES_AUTOHSCROLL
    LTEXT "Comma-separated. Ticked in the Tags menu each time MeetingRecorder starts.", -1, 76, 200, 230, 9
    LTEXT "&Hotwords", -1, 14, 217, 58, 9
    EDITTEXT IDC_HOTWORDS, 76, 215, 230, 13, ES_AUTOHSCROLL
    LTEXT "Comma-separated names and jargon to help transcription.", -1, 76, 230, 230, 9
    LTEXT "&Keep audio", -1, 14, 247, 58, 9
    EDITTEXT IDC_KEEP_DAYS, 76, 245, 28, 13, ES_NUMBER
    LTEXT "days after Speakr is done with it (0 = forever)", -1, 109, 247, 197, 9
    LTEXT "&Upload after", -1, 14, 263, 58, 9
    EDITTEXT IDC_UPLOAD_DELAY, 76, 261, 28, 13, ES_NUMBER
    LTEXT "seconds (0 to 3600; 0 = at once)", -1, 109, 263, 197, 9
    LTEXT "&Only these apps", -1, 14, 279, 58, 9
    EDITTEXT IDC_LOOPBACK_APPS, 76, 277, 230, 13, ES_AUTOHSCROLL
    LTEXT "&Detect calls", -1, 14, 295, 58, 9
    COMBOBOX IDC_CALL_DETECTION, 76, 293, 230, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "When Teams, Zoom, Meet, WhatsApp or a softphone starts a call.", -1, 76, 308, 230, 9
    AUTOCHECKBOX "Record me and the others on separate &channels (stereo)", IDC_SEPARATE, 14, 322, 292, 10
    AUTOCHECKBOX "Start in &local-only (sensitive) mode", IDC_SENSITIVE, 14, 333, 292, 10
    AUTOCHECKBOX "Start MeetingRecorder when I sign &in to Windows", IDC_AUTOSTART, 14, 344, 292, 10

    PUSHBUTTON "Open settings &file", IDC_OPEN_FILE, 7, 366, 76, 14
    DEFPUSHBUTTON "&Save", IDOK, 207, 366, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 263, 366, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION MEETINGRECORDER_VERSION_MAJOR, MEETINGRECORDER_VERSION_MINOR, MEETINGRECORDER_VERSION_PATCH, 0
PRODUCTVERSION MEETINGRECORDER_VERSION_MAJOR, MEETINGRECORDER_VERSION_MINOR, MEETINGRECORDER_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Feridoun"
            VALUE "FileDescription", "MeetingRecorder"
            VALUE "FileVersion", MEETINGRECORDER_VERSION_STRING
            VALUE "InternalName", "MeetingRecorder"
            VALUE "LegalCopyright", "Copyright (c) 2026 Feridoun. MIT licence."
            VALUE "OriginalFilename", "MeetingRecorder.exe"
            VALUE "ProductName", "MeetingRecorder"
            VALUE "ProductVersion", MEETINGRECORDER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
